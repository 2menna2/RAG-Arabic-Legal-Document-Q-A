# Copy to .env and fill in. Never commit .env. All variables are optional unless marked REQUIRED.
# Comments must stay on their own lines: `docker run --env-file` does NOT strip inline comments.

# --- Application
# APP_ENV: dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
# LOG_QUESTIONS: none | hashed | redacted | full  (privacy of user questions in logs)
LOG_QUESTIONS=hashed
RAG_CONFIG_PATH=configs/rag.yaml
DATA_DIR=data
INDEX_DIR=data/index

# --- LLM (Gemini). REQUIRED for /api/v1/ask (without it /ready is 503 and /ask returns 503 llm_unavailable)
# LLM_PROVIDER: gemini | none (none = retrieval-only deployment)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# verify the model id is available to your key
GEMINI_MODEL=gemini-3.8-flash
# used only if configs/rag.yaml embedding.provider=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
# longest wait honoured when Gemini answers 429 with a retry delay (API requests); evaluation uses its own flag
LLM_MAX_RETRY_WAIT_S=8
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048

# --- Vector store (Qdrant): set QDRANT_URL for a server, or QDRANT_PATH for embedded mode (single process only)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_TIMEOUT_S=5

# --- API protection
# CORS_ORIGINS: JSON list, e.g. ["https://app.example.com"]
CORS_ORIGINS=[]
# per client IP, per replica (0 disables)
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_CHARS=1000
REQUEST_TIMEOUT_S=60
# reserved; no admin endpoints are exposed in this version
ADMIN_TOKEN=

# --- Experiment tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ecc-rag

# --- docker-compose only
GRAFANA_ADMIN_USER=admin
# REQUIRED when the monitoring profile is used
GRAFANA_ADMIN_PASSWORD=
